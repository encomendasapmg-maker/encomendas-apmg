# Opcional: a configuração do app já está em src/firebase.js.
# Copie para ".env.local" só se quiser apontar para outro projeto em testes.
# Esses valores identificam o projeto; não são senhas. A proteção dos dados
# fica nas regras do Firestore (firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=encomendas-apmg.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=encomendas-apmg
VITE_FIREBASE_STORAGE_BUCKET=encomendas-apmg.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave pública para notificações (desligadas nesta versão; ver README, seção 5).
VITE_FIREBASE_VAPID_KEY=
