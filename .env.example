# Copie este arquivo para ".env.local" e preencha com os dados do app Web
# registrado no Firebase (Configurações do projeto › Seus apps › Config).
# Esses valores identificam o projeto; não são senhas. A proteção dos dados
# fica nas regras do Firestore (firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=encomendas-apmg.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=encomendas-apmg
VITE_FIREBASE_STORAGE_BUCKET=encomendas-apmg.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave pública para notificações (Configurações do projeto › Cloud Messaging ›
# Certificados push da Web › Gerar par de chaves).
VITE_FIREBASE_VAPID_KEY=
